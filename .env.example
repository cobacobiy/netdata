# Netdata version tag (docker hub: netdata/netdata)
NETDATA_VERSION=latest

# Container memory limit
NETDATA_MEM_LIMIT=256m

# Host port for the dashboard (LAN access via http://192.x.x.x:19999)
NETDATA_PORT=19999

# External docker network shared with traefik/cloudflared (must exist)
# COMPOSE_PROJECT_NAME=netdata
